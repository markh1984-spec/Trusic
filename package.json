{
  "name": "trusic",
  "private": true,
  "description": "Trusic: music streaming with AI transparency built into the payouts.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @trusic/api --filter @trusic/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @trusic/api start",
    "mobile": "pnpm --filter @trusic/mobile start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "pnpm --filter @trusic/api seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
