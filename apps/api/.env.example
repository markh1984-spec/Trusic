# Copy to .env to configure the API locally. Every value here is optional in development.

# Real Postgres. Leave unset to use embedded Postgres stored in TRUSIC_DATA_DIR.
# DATABASE_URL=postgres://trusic:trusic@localhost:5432/trusic
TRUSIC_DATA_DIR=.data

PORT=3001
HOST=127.0.0.1

# Signs short-lived audio URLs. Required in production: openssl rand -hex 32
STREAM_SIGNING_SECRET=

CURRENCY=GBP
# What Premium costs per month including VAT, in pence.
PREMIUM_MONTHLY_PRICE_MINOR=1099
# VAT included in that price, in basis points (2000 = 20%). Revenue is booked without it.
VAT_RATE_BPS=2000
# Demo billing only: what one subscriber brings in per month, net of VAT (£10.99 less 20% VAT).
PREMIUM_MONTHLY_NET_MINOR=916

# Stripe (see docs/STRIPE.md). Leave unset for demo billing: no real money, no setup.
# Use test-mode keys (sk_test_…) until you're ready to launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where the web app is, so Stripe can send people back to it.
PUBLIC_URL=http://localhost:5173
# Artists are paid once their available balance reaches this, in pence.
PAYOUT_MINIMUM_MINOR=1000

# People who register with these emails become admins.
ADMIN_EMAILS=

# Browser origins allowed to call the API directly (comma separated). Not needed when the
# web app is served by the API or through the Vite dev proxy.
CORS_ORIGINS=

MAX_UPLOAD_MB=200

# Public demo settings (see docs/HOSTING.md).
# "closed" stops anyone creating an account. Visitors can still browse and hear previews.
REGISTRATION=open
# Password for the demo accounts the seed script creates (at least 8 characters). When set, the server also gives
# existing demo accounts this password when it starts.
DEMO_PASSWORD=
# Docker image only: load the demo data when the database is empty.
DEMO_SEED=false
