{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Electron's main process and sandboxed preloads load CommonJS most reliably.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test"]
}
