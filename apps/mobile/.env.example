# Copy this file to .env and change the addresses. Restart `pnpm start` after any change.

# The Trusic API.
# - Browser or iPhone simulator on this computer: http://localhost:3001/api
# - Android emulator: http://10.0.2.2:3001/api
# - Your own phone (Expo Go): your computer's address on your Wi-Fi, e.g. http://192.168.1.20:3001/api
#   (and start the API with HOST=0.0.0.0 so the phone can reach it)
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# The Trusic website, where listeners subscribe. Leave it out to use the API's address
# (in production the API serves the website). In development the website runs on port 5173.
# EXPO_PUBLIC_SITE_URL=http://localhost:5173
